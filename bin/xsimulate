#!/bin/bash

if [ "$1" = "click" ];then
  (xdotool "click" --clearmodifiers "$2")&
  exit
fi

if [ "$1" = "type" ];then
  shift
  (xdotool "type" --clearmodifiers "$@")&
  exit
fi

if [ "$1" = "key" ];then
  shift
  (xdotool "key" --clearmodifiers "$@")&
  exit
fi

if [ "$1" = "enter" ];then
  shift
  echo "[$@]"
  (xdotool "type" "$@"; xdotool key "Return")&
  exit
fi
