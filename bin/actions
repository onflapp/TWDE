#!/bin/perl

$TWDE_HOME=$ENV{'TWDE_HOME'};
$CURRENT_DIR="";

sub expand_args {
  my ($cmd, $args) = @_;

  $cmd =~ s/%s/$args/g;
  $cmd =~ s/%f/$args/g;

  return $cmd;
}

sub match_action {
  my ($cfg, $text) = @_;
  
  print("?$text $cfg\n");
  open (IN, $cfg);
  while (<IN>) {
    chomp();
    if (m/^(.*?)\t(.*?)$/) {
      my $pat = $1;
      my $act = $2;

      if ($text =~ $pat) {
        my $cmd = expand_args($act, $text);

        system("$cmd");
        return 1;
      }
    }
  }

  return 0;
}

sub init_context {
  open (IN, "$TWDE_HOME/libexec/system.d/windowmanager get_window x current_dir |");
  while (<IN>) {
    chomp();
    $CURRENT_DIR=$_;
  }
  close (IN);
}

sub guess_file {
  my ($f) = @_;
  my $cfg = "$TWDE_HOME/etc/guess-file.menu";

  init_context();
  
  if (-f "$f") {
    return match_action($cfg, $f);
  }
  if (-f "$CURRENT_DIR/$f") {
    return match_action($cfg, "$CURRENT_DIR/$f");
  }

  $cfg = "$TWDE_HOME/etc/guess-dir.menu";

  if (-d $f) {
    return match_action($cfg, $f);
  }
  if (-d "$CURRENT_DIR/$f") {
    return match_action($cfg, "$CURRENT_DIR/$f");
  }
  
  return 0;
}

sub guess_url {
  my ($u) = @_;
  my $cfg = "$TWDE_HOME/etc/guess-url.menu";

  return match_action($cfg, $u);
}

sub guess_text {
  my ($f) = @_;
  my $cfg = "$TWDE_HOME/etc/guess.menu";
  
  return 0;
}

init_context();

while(<STDIN>) {
  chomp();
  my $text = $_;

  if (guess_file($text)) {
  }
  elsif (guess_url($text)) {
  }
  elsif (guess_text($text)) {
  }
}
