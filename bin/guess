#!/bin/perl

$TWDE_HOME=$ENV{'TWDE_HOME'};
$CURRENT_DIR="";
@LINES=();
@TYPES=();
@FOUND=();

sub init_context {
  open (IN, "$TWDE_HOME/libexec/system.d/windowmanager get_window x current_dir |");
  while (<IN>) {
    chomp();
    $CURRENT_DIR=$_;
  }
  close (IN);
}

sub match_single_path {
  my ($line, $type) = @_;

  if (-f $line && $type eq "file") {
    push(@FOUND, "$line");
    return 1;
  }

  if (-d $line && $type eq "dir") {
    push(@FOUND, "$line");
    return 1;
  }

  return 0;
}

sub guess_url {
  my ($line, $type) = @_;
  $line =~ s/^\s*//;
  $line =~ s/\s*$//;

  my @a = split(' ', $line);
  foreach(@a) {
  }
}

sub guess_path {
  my ($line, $type) = @_;
  $line =~ s/^\s*//;
  $line =~ s/\s*$//;

  if (match_single_path($line, $type)) {
    return;
  }

  my @a = split(' ', $line);
  foreach(@a) {
    if (match_single_path($line, $type)) {
      return;
    }
  }
}

sub write_text {
  my $tf = "/tmp/$$-guess.txt";
  
  open(OUT, "> $tf");
  foreach(@LINES) {
    print(OUT "$_\n");
  }
  close(OUT);
  
  push(@FOUND, $tf);
}

sub guess_type {
  my ($type) = @_;
  
  foreach(@LINES) {
    guess_path($_, $type) if ($type eq "file" || $type eq "dir");   
  }

  if ($type eq "text") {
    @FOUND=() if ($#LINES > 0);
    write_text();
  }
}

#init_context();

foreach(@ARGV) {
  push(@TYPES, $_);
}

while(<STDIN>) {
  chomp();
  $_ =~ s/\s*$//;
  push(@LINES, $_);
}

foreach (@TYPES) {
  guess_type($_);
}

foreach (@FOUND) {
  print("$_\n");
  exit 0;
}
