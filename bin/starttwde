#!/usr/bin/env bash

function init_home() {
  mkdir -p "$TWDE_HOME/var" 2>/dev/null
}

function init_exec() {
  $TWDE_HOME/libexec/init.d/$1 $2
}

function process() {
  echo "starting"
  init_home

  init_exec keyboard start
  init_exec mouse start
  init_exec display start
  init_exec desktop start
  init_exec gestures start
  init_exec hotkeys start

  echo "about to launch windowmanager"
  init_exec wm
  echo "windowmanager exited"

  echo "stopping"
  init_exec hotkeys stop
  init_exec display stop
}

if [ -z "$TWDE_HOME" ];then
  B=`realpath "$0"`
  B=`dirname "$B"`
  B=`dirname "$B"`
  export TWDE_HOME="$B"
fi

export TWDE_LOG="/tmp/$UID-desktop.log"
export PATH="$TWDE_HOME/bin:$TWDE_HOME/apps:$TWDE_HOME/libexec:$PATH"

if [ "x$1" == "x--safe-mode" ];then
  init
  echo "safe mode"
  exec xterm
fi

process > $TWDE_LOG 2>&1
