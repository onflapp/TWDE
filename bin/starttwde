#!/usr/bin/env bash

function init_home() {
  if ! [ -d "$TWDE_VAR" ];then
    mkdir -p "$TWDE_VAR" 2>/dev/null
  fi
}

function init_exec() {
  $TWDE_HOME/libexec/init.d/$1 $2
}

function run_on_exit() {
  if [ -f "$TWDE_RUN_ON_EXIT" ];then
    source "$TWDE_RUN_ON_EXIT"
    rm "$TWDE_RUN_ON_EXIT"
  fi
}

function start_wm() {
  init_exec wm_fvwm start
  #init_exec wm_twm start
}

function process() {
  echo "starting"

  init_exec keyboard start
  init_exec mouse start
  init_exec display start
  init_exec desktop start
  init_exec gestures start

  echo "about to launch windowmanager"
  start_wm
  echo "windowmanager exited"

  echo "stopping"
  init_exec keyboard stop
  init_exec hotkeys stop
  init_exec display stop

  run_on_exit
}

if [ -z "$TWDE_HOME" ];then
  B=`realpath "$0"`
  B=`dirname "$B"`
  B=`dirname "$B"`
  export TWDE_HOME="$B"
fi

export TWDE_VAR="$TWDE_HOME/var"
export TWDE_RUN_ON_EXIT="$TWDE_HOME/var/$$.run_on_exit"
export TWDE_LOG="$TWDE_VAR/desktop.log"
export PATH="$TWDE_HOME/bin:$TWDE_HOME/apps:$TWDE_HOME/bin/system:$TWDE_HOME/bin/config:$PATH"

if [ "x$1" == "x--safe-mode" ];then
  init
  echo "safe mode"
  exec xterm
fi

init_home

if ! [ -t 1 ];then
  process > $TWDE_LOG 2>&1
else
  process
fi
