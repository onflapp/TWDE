#!/usr/bin/env bash

CFG="$TWDE_HOME/var/widget.xrm"
$TWDE_HOME/libexec/make_config "$TWDE_HOME/lib/widget.xrm" \
  $TWDE_HOME/etc/theme.conf > "$CFG"

xrdb -merge "$CFG"

if [ -n "$GEOMETRY" ];then
  POS="-geometry $GEOMETRY"
fi

WPATH=`realpath "$1"`
if ! [ -x "$WPATH" ];then
  WPATH=`type -p "$1"`
fi

if ! [ -x "$WPATH" ];then
  echo "$WPATH is not executable"
  exit 1
fi

shift

export WIDGET_MODE="1"
exec xterm $POS -name TWDEWidget -class TWDEWidget -e "$WPATH $@" &
