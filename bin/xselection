#!/usr/bin/env bash

. $TWDE_HOME/lib/func.sh

xclip=`locate_command xclip`

function read_selection() {
  T=/tmp/$$.selection.tmp

  $xclip -o -selection > $T

  cat $T
  rm $T
}

function write_selection() {
  $xclip -i -selection primary "$1"
}

if [ -f "$1" ];then
  write_selection "$1"
else
  read_selection
fi
