#!/usr/bin/env bash

function suspend() {
  systemctl suspend
}

function restart() {
  /sbin/reboot
}

function off() {
  if [ -n "$TWDE_RUN_ON_EXIT" ];then
    echo "/sbin/poweroff" > $TWDE_RUN_ON_EXIT
    FvwmCommand Quit
  else
    /sbin/poweroff
  fi
}

function list_profiles() {
  powerprofilesctl list | while read -r line ;do
    if [[ "$line" =~ ^\*?\ ?(.*):$ ]];then
      val="${BASH_REMATCH[1]}"
      echo "$val"
    fi
  done
}

function show_current_profile() {
  powerprofilesctl get
}

function change_current_profile_to() {
  powerprofilesctl set "$1"
}

function print_config() {
  upower -d | while read -r line ;do
    if [[ "$line" =~ Device:.* ]];then
      stat=""
      per=""
      rech=""

    elif [[ "$line" =~ rechargeable:\ +(.*)$ ]];then
      rech=${BASH_REMATCH[1]}

    elif [[ "$line" =~ state:\ +(.*)$ ]];then
      stat=${BASH_REMATCH[1]}

    elif [[ "$line" =~ percentage:\ +(.*)%$ ]];then
      per=${BASH_REMATCH[1]}

      if [ "$rech" = "yes" ];then
        echo "CURRENT_VALUE=$per"
      fi
    fi
  done
  echo "CURRENT_PROFILE=`powerprofilesctl get`"
}

function battery_status() {
  source <(print_config)
  echo "$CURRENT_VALUE%"
}

function usage() {
  echo "power"
  echo "power suspend"
  echo "power off"
  echo "power restart"
  echo "power battery_status"
  echo "power list_profiles"
  echo "power show_current_profile"
  echo "power change_current_profile_to [profile]"

  exit 1
}

if [ -z "$1" ];then
  usage
else
  "$1" "$2" "$3" "$4"
fi
