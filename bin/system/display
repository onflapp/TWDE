#!/usr/bin/env bash

. $TWDE_HOME/lib/func.sh

function list_screens() {
  xrandr | while read -r line ;do
    if [[ "$line" =~ ^(.*)\ connected\ (.*)$ ]];then
      display_name="${BASH_REMATCH[1]}"
      display_info="${BASH_REMATCH[2]}"
      echo "$display_name"
    fi
  done
}

function show_screen() {
  if [ "$2" = "resolutions" ];then
    xrandr | while read -r line ;do
      if [[ "$line" =~ ^(.*)\ connected\ (.*)$ ]];then
        display_name="${BASH_REMATCH[1]}"
      fi

      if [ "$display_name" = "$1" ];then
        if [[ "$line" =~ ^([0-9]+)x([0-9]+)  ]];then
          w="${BASH_REMATCH[1]}"
          h="${BASH_REMATCH[2]}"

          echo "${w}x${h}"
        fi
      fi
    done
  fi
  if [ "$2" = "brightness" ];then
    brightnessctl | regexp 'Current brightness.*\((\d\d*)%\)' '%s' '$1'
  fi
}

function place_screen() {
  if [ "$2" = "right_of" ];then
    primary="$3"
    secondary="$1"
    xrandr --output "$primary" --auto --output "$secondary" --auto --right-of "$primary"

  elif [ "$2" = "left_of" ];then
    primary="$3"
    secondary="$1"
    xrandr --output "$primary" --auto --output "$secondary" --auto --left-of "$primary"

  elif [ "$2" = "above" ];then
    primary="$3"
    secondary="$1"
    xrandr --output "$primary" --auto --output "$secondary" --auto --above "$primary"

  elif [ "$2" = "below" ];then
    primary="$3"
    secondary="$1"
    xrandr --output "$primary" --auto --output "$secondary" --auto --below "$primary"

  fi

  save_screen_layout
}

function turn_screen() {
  if [ "$2" = "off" ];then
    xrandr --output "$1" --off
  fi
  if [ "$2" = "on" ];then
    xrandr --output "$1" --auto
  fi
}

function save_screen_layout() {
  local N="layout"
  for DD in `xrandr | regexp '^(.*) connected ' '%s\n' '$1' ` ;do
    N="${N}_${DD}"
  done
  autorandr --force --save $N
}

function list_screen_layouts() {
  autorandr --list | grep layout_
}

function restore_screen_layout() {
  if [ -z "$1" ];then
    autorandr --change
  else
    autorandr --load "$1"
  fi
}

function change_screen() {
  if [ "$2" = "resolution_to" ];then
    xrandr --output "$1" --mode "$3"
  fi
  if [ "$2" = "scale_to" ];then
    xrandr --output "$1" --auto --scale "$3"
  fi
  if [ "$2" = "brightness_to" ];then
    brightnessctl s "$3%" >/dev/null
    #xbacklight -set $3
    #xrandr --output "$1" --brightness $3
  fi
  if [ "$2" = "brightness_up" ];then
    brightnessctl s "+10%" | regexp 'Current brightness.*\((\d\d*)%\)' '%s' '$1'
  fi
  if [ "$2" = "brightness_down" ];then
    brightnessctl s "10%-" | regexp 'Current brightness.*\((\d\d*)%\)' '%s' '$1'
  fi
}


function usage() {
  echo "display"
  echo "display list_screens"
  echo "display place_screen [screen1] right_of|left_of|above|below [screen2]"
  echo "display turn_screen [screen] off|on"
  echo "display show_screen [screen] resolutions"
  echo "display show_screen [screen] brightness"
  echo "display change_screen [screen] resolution_to [val]"
  echo "display change_screen [screen] scale_to [val]"
  echo "display change_screen [screen] brightness_to [val]"
  echo "display change_screen [screen] brightness_up | brightness_down"
  echo "display save_screen_layout"
  echo "display restore_screen_layout"

  exit 1
}

if [ -z "$1" ];then
  usage
else
  "$1" "$2" "$3" "$4"
fi
