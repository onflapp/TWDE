#!/usr/bin/env bash

function list_outputs() {
  pactl list short sinks | while read -r line ;do
    if [[ "$line" =~ ^([0-9]+)\	([^	]+) ]];then
      dev_name="${BASH_REMATCH[2]}"
      echo "$dev_name"
    fi
  done
}

function change_output() {
  dev_name="$1"
  [ "$dev_name" = "default" ] && dev_name="0"
  if [ "$2" = "volume_to" ];then
    pactl -- set-sink-volume "$dev_name" "$3%"
  fi
  if [ "$2" = "volume_up" ];then
    pactl -- set-sink-volume "$dev_name" "+5%"
  fi
  if [ "$2" = "volume_down" ];then
    pactl -- set-sink-volume "$dev_name" "-5%"
  fi
  if [ "$2" = "volume_mute" ];then
    pactl -- set-sink-mute "$dev_name" "toggle"
  fi
  show_output "$dev_name" "volume"
}

function make_output() {
  dev_name="$1"
  [ "$dev_name" = "default" ] && dev_name="0"
  if [ "$2" = "default" ];then
    pactl -- set-default-sink "$dev_name"
  fi
}

function show_default_output() {
  pactl -- get-default-sink
}

function show_output() {
  dev_name="$1"

  [ -z "$dev_name" ] && dev_name="0"
  [ "$dev_name" = "default" ] && dev_name="0"

  if [ "$2" = "description" ];then
    if [ "$1" = "default" ];then
      dev_name=`pactl get-default-sink`
    fi

    pactl list sinks | while read -r line ;do
      if [[ "$line" =~ Name:\ (.*)$ ]];then
        val="${BASH_REMATCH[1]}"
        if [ "$val" = "$dev_name" ];then
          found="${BASH_REMATCH[1]}"
        fi
      fi
      if [ -n "$found" ] && [[ "$line" =~ Description:\ (.*)$ ]];then
        val="${BASH_REMATCH[1]}"
        echo "$val"
        exit 0
      fi
    done

  elif [ "$2" = "volume" ];then
    pactl -- get-sink-mute "$dev_name" | while read -r line ;do
      if [[ "$line" = "Mute: yes" ]];then
        echo "-"
        exit 1
      fi
    done

    [ $? -eq 1 ] && return

    pactl -- get-sink-volume "$dev_name" | while read -r line ;do
      if [[ "$line" =~ ^Volume:.*\ ([0-9]+)% ]];then
        val="${BASH_REMATCH[1]}"
        echo "$val"
      fi
    done
  fi
}

function play_sample() {
  pacat $TWDE_HOME/lib/ping.wav&
}

function usage() {
  echo "audio"
  echo "audio list_outputs"
  echo "audio change_output [out] volume_to [val]"
  echo "audio change_output [out] volume_up | volume_down | volume_mute"
  echo "audio make_output [out] default"
  echo "audio show_output [out] volume"
  echo "audio show_output [out] description"
  echo "audio show_default_output"
  echo "audio play_sample"

  exit 1
}

if [ -z "$1" ];then
  usage
else
  "$1" "$2" "$3" "$4"
fi
