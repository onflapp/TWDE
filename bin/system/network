#!/usr/bin/env bash

function _scan_network() {
  avahi-browse --all --ignore-local --resolve -t | while read -r line ;do
    if [[ "$line" =~ ^=(.*)\ \ \ *(.*)\ +local$ ]];then
      name=${BASH_REMATCH[2]}
    fi
    if [[ "$line" =~ ^port\ =\ \[(.*)\]$  ]];then
      port=${BASH_REMATCH[1]}
      if [ "$port" != "0" ];then
        echo "$host $addrs $port"
      fi
    fi
    if [[ "$line" =~ ^hostname\ =\ \[(.*)\]$  ]];then
      host=${BASH_REMATCH[1]}
    fi
    if [[ "$line" =~ ^address\ =\ \[(.*)\]$  ]];then
      addrs=${BASH_REMATCH[1]}
    fi

  done
}

function scan_hosts() {
  _scan_network | sort -u
}

function manage_network_configuration() {
  f="/etc/network/interfaces"
  cp "$f" "$f.bak"

  systemctl stop networking
  systemctl disable networking

  cat << EOF > $f
# managed by network-manager
auto lo
iface lo inet loopback
EOF

  f="/etc/NetworkManager/NetworkManager.conf"
  cp "$f" "$f.bak"

  cat << EOF > $f
[main]
plugins=ifupdown,keyfile

[ifupdown]
managed=true
EOF

  systemctl enable NetworkManager
  systemctl start NetworkManager
}

function usage() {
  echo "display"
  echo "display scan_hosts"

  exit 1
}

if [ -z "$1" ];then
  usage
else
  "$1" "$2" "$3" "$4"
fi
