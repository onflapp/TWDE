#!/bin/bash

source $TWDE_HOME/lib/libs.sh

DT="$TWDE_HOME/libexec/datatypes.d"
DC="/tmp/datatype-cache-$UID"

function guess_mime() {
  if [[ "$1" =~ /cur/ ]] || [[ "$1" =~ /new/ ]];then
    echo "message/rfc822"
    return 1
  fi

  ### try file magic
  local m=`file --mime-type "$1" `
 
  if [[ "$m" =~ .*:\ (.*)$ ]];then
    m="${BASH_REMATCH[1]}"
    echo "$m"
  else
    echo ""
  fi
}

if ! [ -f "$2" ];then
  echo "datatype [action] [file]"
  exit 1
fi

TYPE="$1"
FILE=`f_abspath "$2"`
EXT="${FILE##*.}"
MIME=`guess_mime "$FILE"`

DTEXEC="$DT/$MIME/$TYPE"

if ! [ -x "$DTEXEC" ];then
  echo "unable to find datatype $DTEXEC for $FILE"
  exit 1
fi

HASH=`checksum "$FILE"`
DATATYPE_CACHE="$DC/$HASH"

if ! [ -d "$DATATYPE_CACHE" ];then
  mkdir -p "$DATATYPE_CACHE"
fi

export DATATYPE_CACHE
exec "$DTEXEC" "$FILE"
