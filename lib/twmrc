#
# Default twm configuration file; needs to be kept small to conserve string
# space in systems whose compilers don't handle medium-sized strings.
#
# Sites should tailor this file, providing any extra title buttons, menus, etc.
# that may be appropriate for their environment.  For example, if most of the
# users were accustomed to uwm, the defaults could be set up not to decorate
# any windows and to use meta-keys.
#

NoGrabServer
RestartPreviousState
DecorateTransients
BorderWidth "$FRAME_BORDER"
OpaqueMove
RandomPlacement
NoTitleHighlight
TitleButtonBorderWidth 1
TitlePadding 4
TitleFont "$APP_FONT"
ResizeFont "$APP_FONT"
MenuFont "$APP_FONT"
IconFont "$APP_FONT"
IconManagerFont "$APP_FONT"
#ClientBorderWidth

Color
{
    BorderColor "$BORDER_COLOR" {
      "TWDEWidget" "forestgreen"
    }
    DefaultBackground "$BACKGROUND_COLOR"
    DefaultForeground "$FOREGROUND_COLOR"
    TitleBackground "$BACKGROUND_COLOR"
    TitleForeground "$FOREGROUND_COLOR"
    MenuBackground "$MENU_BACKGROUND_COLOR"
    MenuForeground "$MENU_FOREGROUND_COLOR"
    MenuBorderColor "$MENU_BORDER_COLOR"
    MenuTitleBackground "$BACKGROUND_COLOR"
    MenuTitleForeground "$ACTIVE_COLOR"
    IconBackground "$DESKTOP_COLOR"
    IconForeground "forestgreen"
    IconBorderColor "forestgreen"
    IconManagerBackground "$MENU_BACKGROUND_COLOR"
    IconManagerForeground "$MENU_FOREGROUND_COLOR"
    IconManagerHighlight "$BORDER_COLOR"
}

#
# Define some useful functions for motion-based actions.
#
MoveDelta 3
Function "move-or-lower" { f.move f.deltastop f.lower }
Function "move-or-raise" { f.move f.deltastop f.raise }
Function "move-or-iconify" { f.move f.deltastop f.iconify }
Function "focus-and-raise" { f.focus f.raise }
Function "raise-and-warp" { f.raise }
Function "move-or-focus-and-raise" { f.unfocus f.focus f.raise f.exec "event activate" f.move f.deltastop }
Function "reload-config" { f.exec "$TWDE_HOME/libexec/init.d/wm_twm reload" f.restart }
Function "power-off" { f.exec "echo '/sbin/poweroff' > $TWDE_RUN_ON_EXIT" f.quit }

#
# Set some useful bindings.  Sort of uwm-ish, sort of simple-button-ish
#
Button1 = : root : f.menu "main"
Button3 = : root : f.menu "TwmWindows"
Button3 = : title : f.menu "windowops"

Button1 = m : window|icon : f.function "move-or-lower"
Button2 = m : window|icon : f.iconify

Button1 = : title : f.function "move-or-raise"

Button1 = : icon : f.function "move-or-iconify"
Button2 = : icon : f.iconify

Button1 = : iconmgr : f.function "focus-and-raise"
Button2 = : iconmgr : f.iconify

#WindowFunction { f.raise f.warpring "next" }

#
# And a menus with the usual things
#
menu "main"
{
		"Applications"		f.title
    `menu2twm $TWDE_HOME/etc/wm.menu`
		"Selection"			f.title
    `menu2twm $TWDE_HOME/etc/selection.menu`
		"Window Manager"			f.title
		"Reload config"	  f.function "reload-config"
		"Exit"			f.menu "Quit-Verify"
}

menu "Quit-Verify"
{
		"Logout"	f.quit
		"Sleep"	f.exec "power suspend"
		"Power off"	f.function "power-off"
}

menu "windowops"
{
		"Window Ops"		f.title
		"Iconify"		f.iconify
		"Resize"		f.resize
		"Move"			f.move
		"Raise"			f.raise
		"Lower"			f.lower
		"Maximize"			f.exec "async maximize"
		"Full Screen"			f.fullzoom
		""			f.nop
		"Focus"			f.focus
		"Unfocus"		f.unfocus
		""			f.nop
    `menu2twm $TWDE_HOME/etc/windowops.menu`
		""			f.nop
		"Close"		f.delete
}

LeftTitleButton "$TWDE_HOME/lib/left.xbm" = f.menu "windowops"
RightTitleButton "$TWDE_HOME/lib/right.xbm" = f.lower

IconManagerDontShow
{
  "TWDEWidget"
  "TWDEMenu"
}

NoHighlight
{
  "TWDEWidget"
  "TWDEMenu"
}

NoStackMode
{
  "TWDEWidget"
  "TWDEMenu"
}

NoTitle 
{
  "TWDEWidget"
  "TWDEMenu"
}
